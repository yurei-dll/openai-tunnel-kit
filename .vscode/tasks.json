{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Create venv and install",
      "type": "process",
      "command": "${workspaceFolder}/scripts/bootstrap-venv.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Python: Build wheel",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pip",
        "wheel",
        "--no-deps",
        "--wheel-dir",
        "${workspaceFolder}/dist",
        "${workspaceFolder}"
      ],
      "dependsOn": "Python: Create venv and install",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
