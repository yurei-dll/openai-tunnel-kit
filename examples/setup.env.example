# Copy this file outside the repository, fill in the paths, then run:
#   source /path/to/setup.env
#   openai-tunnel-kit setup-env
# Values must be exported so the executable can read them.

export OPENAI_TUNNEL_PROFILE="default"
export CONTROL_PLANE_TUNNEL_ID="tunnel_..."

# Keep the key out of this file. The referenced file is read once and the key is
# stored as a systemd encrypted credential.
export CONTROL_PLANE_API_KEY_FILE="$HOME/.config/openai/runtime-api-key"

export OPENAI_TUNNEL_MCP_FILE="/absolute/path/to/mcp.json"
export TUNNEL_CLIENT_BIN="/absolute/path/to/tunnel-client"
export TUNNEL_CLIENT_ARGS=""
export OPENAI_TUNNEL_KIT_PASS_DESKTOP_ENVIRONMENT="false"
